{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SalamancaLabs/claude-google-play/schema/app-content.schema.json",
  "title": "Play Console App content answers",
  "description": "Every Play Console App content answer is an 'answer': a value, the evidence behind it, and a status. 'confirmed' needs at least one evidence item and a non-null value; 'needs_review' may have a null value and carries the open 'question'. Keys are stable snake_case per question, never Console label text.",
  "type": "object",
  "required": ["package_name", "app_name", "sections"],
  "additionalProperties": false,
  "properties": {
    "package_name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$" },
    "app_name": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privacy_policy", "app_access", "ads", "advertising_id", "content_rating", "target_audience",
        "news_app", "data_safety", "government_app", "financial_features", "health_apps"
      ],
      "properties": {
        "privacy_policy": {
          "type": "object", "additionalProperties": false, "required": ["url"],
          "properties": { "url": { "$ref": "#/$defs/url_answer" } }
        },
        "app_access": {
          "type": "object", "additionalProperties": false, "required": ["all_functionality_available"],
          "properties": {
            "all_functionality_available": { "$ref": "#/$defs/bool_answer", "description": "true = no login or restriction blocks any feature" },
            "access_instructions": { "$ref": "#/$defs/string_answer", "description": "Credentials or steps for reviewers. Required when all_functionality_available is false, forbidden when true." }
          },
          "allOf": [
            {
              "if": { "required": ["all_functionality_available"], "properties": { "all_functionality_available": { "required": ["value"], "properties": { "value": { "const": false } } } } },
              "then": { "required": ["access_instructions"] }
            },
            {
              "if": { "required": ["all_functionality_available"], "properties": { "all_functionality_available": { "required": ["value"], "properties": { "value": { "const": true } } } } },
              "then": { "properties": { "access_instructions": false } }
            }
          ]
        },
        "ads": {
          "type": "object", "additionalProperties": false, "required": ["contains_ads"],
          "properties": { "contains_ads": { "$ref": "#/$defs/bool_answer" } }
        },
        "advertising_id": {
          "type": "object", "additionalProperties": false, "required": ["uses_advertising_id", "purposes"],
          "properties": {
            "uses_advertising_id": { "$ref": "#/$defs/bool_answer" },
            "purposes": { "$ref": "#/$defs/purpose_list_answer", "description": "Non-empty when the advertising ID is used; empty list when it is not" }
          },
          "allOf": [
            {
              "if": { "required": ["uses_advertising_id"], "properties": { "uses_advertising_id": { "required": ["value"], "properties": { "value": { "const": true } } } } },
              "then": { "properties": { "purposes": { "properties": { "value": { "minItems": 1 } } } } }
            },
            {
              "if": { "required": ["uses_advertising_id"], "properties": { "uses_advertising_id": { "required": ["value"], "properties": { "value": { "const": false } } } } },
              "then": { "properties": { "purposes": { "properties": { "value": { "maxItems": 0 } } } } }
            }
          ]
        },
        "content_rating": {
          "type": "object", "additionalProperties": false, "required": ["category", "questionnaire"],
          "properties": {
            "category": { "$ref": "#/$defs/string_answer", "description": "IARC questionnaire category chosen in the Console (free text; no official category list confirmed)" },
            "questionnaire": {
              "type": "object",
              "description": "One answer per IARC question, snake_case key. Questions vary by category.",
              "additionalProperties": { "$ref": "#/$defs/scalar_answer" }
            }
          }
        },
        "target_audience": {
          "type": "object", "additionalProperties": false, "required": ["age_groups", "appeals_to_children"],
          "properties": {
            "age_groups": { "$ref": "#/$defs/age_group_list_answer" },
            "appeals_to_children": { "$ref": "#/$defs/bool_answer" }
          }
        },
        "news_app": {
          "type": "object", "additionalProperties": false, "required": ["is_news_app"],
          "properties": { "is_news_app": { "$ref": "#/$defs/bool_answer" } }
        },
        "data_safety": {
          "type": "object", "additionalProperties": false, "required": ["collects_or_shares_user_data"],
          "description": "data_types and security are required when collects_or_shares_user_data is true and forbidden when it is false.",
          "properties": {
            "collects_or_shares_user_data": { "$ref": "#/$defs/bool_answer" },
            "data_types": { "$ref": "#/$defs/data_types" },
            "security": {
              "type": "object", "additionalProperties": false, "required": ["encrypted_in_transit", "deletion_request_mechanism"],
              "properties": {
                "encrypted_in_transit": { "$ref": "#/$defs/bool_answer" },
                "deletion_request_mechanism": { "$ref": "#/$defs/deletion_mechanism_answer" }
              }
            }
          },
          "allOf": [
            {
              "if": { "required": ["collects_or_shares_user_data"], "properties": { "collects_or_shares_user_data": { "properties": { "value": { "const": true } }, "required": ["value"] } } },
              "then": { "required": ["data_types", "security"] }
            },
            {
              "if": { "required": ["collects_or_shares_user_data"], "properties": { "collects_or_shares_user_data": { "properties": { "value": { "const": false } }, "required": ["value"] } } },
              "then": { "properties": { "data_types": false, "security": false } }
            }
          ]
        },
        "government_app": {
          "type": "object", "additionalProperties": false, "required": ["is_government_app"],
          "properties": { "is_government_app": { "$ref": "#/$defs/bool_answer" } }
        },
        "financial_features": {
          "type": "object", "additionalProperties": false, "required": ["features"],
          "properties": { "features": { "$ref": "#/$defs/string_list_answer", "description": "Financial features offered (e.g. loans, banking, crypto). Empty list = none." } }
        },
        "health_apps": {
          "type": "object", "additionalProperties": false, "required": ["features"],
          "properties": { "features": { "$ref": "#/$defs/string_list_answer", "description": "Health features offered. Empty list = none." } }
        }
      }
    }
  },
  "$defs": {
    "evidence_item": {
      "description": "One source backing an answer. Give at least one of file, dependency, ticket, owner.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1, "description": "Repo-relative path" },
        "dependency": { "type": "string", "minLength": 1 },
        "ticket": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1, "description": "Statement from the app owner" },
        "note": { "type": "string" }
      },
      "anyOf": [
        { "required": ["file"] }, { "required": ["dependency"] }, { "required": ["ticket"] }, { "required": ["owner"] }
      ]
    },

    "answer": {
      "description": "Base shape of every answer leaf. Typed variants below narrow 'value'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence", "status"],
      "properties": {
        "value": {},
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence_item" } },
        "status": { "enum": ["confirmed", "needs_review"] },
        "question": { "type": "string", "minLength": 1, "description": "Open question, for needs_review" }
      },
      "if": { "required": ["status"], "properties": { "status": { "const": "confirmed" } } },
      "then": { "properties": { "evidence": { "minItems": 1 }, "value": { "not": { "type": "null" } } } }
    },

    "purpose": {
      "enum": [
        "app_functionality", "analytics", "developer_communications", "advertising_or_marketing",
        "fraud_prevention_security_compliance", "personalization", "account_management"
      ]
    },
    "age_group": { "enum": ["5_and_under", "6_8", "9_12", "13_15", "16_17", "18_and_over"] },

    "bool_answer": {
      "allOf": [{ "$ref": "#/$defs/answer" }, { "properties": { "value": { "type": ["boolean", "null"] } } }]
    },
    "string_answer": {
      "allOf": [{ "$ref": "#/$defs/answer" }, { "properties": { "value": { "type": ["string", "null"], "minLength": 1 } } }]
    },
    "scalar_answer": {
      "allOf": [{ "$ref": "#/$defs/answer" }, { "properties": { "value": { "type": ["boolean", "string", "null"] } } }]
    },
    "url_answer": {
      "allOf": [{ "$ref": "#/$defs/answer" }, { "properties": { "value": { "type": ["string", "null"], "pattern": "^https://[^\\s]+$" } } }]
    },
    "string_list_answer": {
      "allOf": [
        { "$ref": "#/$defs/answer" },
        { "properties": { "value": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } }
      ]
    },
    "purpose_list_answer": {
      "allOf": [
        { "$ref": "#/$defs/answer" },
        { "properties": { "value": { "type": ["array", "null"], "items": { "$ref": "#/$defs/purpose" }, "uniqueItems": true } } }
      ]
    },
    "age_group_list_answer": {
      "allOf": [
        { "$ref": "#/$defs/answer" },
        { "properties": { "value": { "type": ["array", "null"], "items": { "$ref": "#/$defs/age_group" }, "uniqueItems": true } } }
      ]
    },
    "deletion_mechanism_answer": {
      "description": "in_app and web_link need the flow or URL cited in evidence",
      "allOf": [
        { "$ref": "#/$defs/answer" },
        { "properties": { "value": { "enum": ["in_app", "web_link", "none", null] } } }
      ]
    },

    "data_type_value": {
      "description": "How one Data safety data type is handled. Purposes, ephemeral and required apply only when collected; sharing_purposes only when shared.",
      "type": "object",
      "additionalProperties": false,
      "required": ["collected", "shared"],
      "properties": {
        "collected": { "type": "boolean" },
        "shared": { "type": "boolean" },
        "ephemeral": { "type": "boolean", "description": "Processed ephemerally (kept in memory only)" },
        "required": { "type": "boolean", "description": "true = collection is required, false = users can choose" },
        "collection_purposes": { "type": "array", "items": { "$ref": "#/$defs/purpose" }, "uniqueItems": true },
        "sharing_purposes": { "type": "array", "items": { "$ref": "#/$defs/purpose" }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": { "properties": { "collected": { "const": true } } },
          "then": { "required": ["collection_purposes", "ephemeral", "required"], "properties": { "collection_purposes": { "minItems": 1 } } },
          "else": { "properties": { "collection_purposes": false, "ephemeral": false, "required": false } }
        },
        {
          "if": { "properties": { "shared": { "const": true } } },
          "then": { "required": ["sharing_purposes"], "properties": { "sharing_purposes": { "minItems": 1 } } },
          "else": { "properties": { "sharing_purposes": false } }
        }
      ]
    },
    "data_type_answer": {
      "allOf": [
        { "$ref": "#/$defs/answer" },
        { "properties": { "value": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/data_type_value" }] } } }
      ]
    },

    "data_types": {
      "description": "Google's Data safety data types. Each must be answered, including 'not collected, not shared'. Keys are descriptive: Google's CSV question IDs could only be partly confirmed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location", "personal_info", "financial_info", "health_and_fitness", "messages", "photos_and_videos", "audio",
        "files_and_docs", "calendar", "contacts", "app_activity", "web_browsing", "app_info_and_performance", "device_or_other_ids"
      ],
      "properties": {
        "location": {
          "type": "object", "additionalProperties": false, "required": ["approximate_location", "precise_location"],
          "properties": { "approximate_location": { "$ref": "#/$defs/data_type_answer" }, "precise_location": { "$ref": "#/$defs/data_type_answer" } }
        },
        "personal_info": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "email_address", "user_ids", "address", "phone_number", "race_and_ethnicity", "political_or_religious_beliefs", "sexual_orientation", "other_info"],
          "properties": {
            "name": { "$ref": "#/$defs/data_type_answer" },
            "email_address": { "$ref": "#/$defs/data_type_answer" },
            "user_ids": { "$ref": "#/$defs/data_type_answer" },
            "address": { "$ref": "#/$defs/data_type_answer" },
            "phone_number": { "$ref": "#/$defs/data_type_answer" },
            "race_and_ethnicity": { "$ref": "#/$defs/data_type_answer" },
            "political_or_religious_beliefs": { "$ref": "#/$defs/data_type_answer" },
            "sexual_orientation": { "$ref": "#/$defs/data_type_answer" },
            "other_info": { "$ref": "#/$defs/data_type_answer" }
          }
        },
        "financial_info": {
          "type": "object", "additionalProperties": false,
          "required": ["user_payment_info", "purchase_history", "credit_score", "other_financial_info"],
          "properties": {
            "user_payment_info": { "$ref": "#/$defs/data_type_answer" },
            "purchase_history": { "$ref": "#/$defs/data_type_answer" },
            "credit_score": { "$ref": "#/$defs/data_type_answer" },
            "other_financial_info": { "$ref": "#/$defs/data_type_answer" }
          }
        },
        "health_and_fitness": {
          "type": "object", "additionalProperties": false, "required": ["health_info", "fitness_info"],
          "properties": { "health_info": { "$ref": "#/$defs/data_type_answer" }, "fitness_info": { "$ref": "#/$defs/data_type_answer" } }
        },
        "messages": {
          "type": "object", "additionalProperties": false, "required": ["emails", "sms_or_mms", "other_in_app_messages"],
          "properties": {
            "emails": { "$ref": "#/$defs/data_type_answer" },
            "sms_or_mms": { "$ref": "#/$defs/data_type_answer" },
            "other_in_app_messages": { "$ref": "#/$defs/data_type_answer" }
          }
        },
        "photos_and_videos": {
          "type": "object", "additionalProperties": false, "required": ["photos", "videos"],
          "properties": { "photos": { "$ref": "#/$defs/data_type_answer" }, "videos": { "$ref": "#/$defs/data_type_answer" } }
        },
        "audio": {
          "type": "object", "additionalProperties": false, "required": ["voice_or_sound_recordings", "music_files", "other_audio_files"],
          "properties": {
            "voice_or_sound_recordings": { "$ref": "#/$defs/data_type_answer" },
            "music_files": { "$ref": "#/$defs/data_type_answer" },
            "other_audio_files": { "$ref": "#/$defs/data_type_answer" }
          }
        },
        "files_and_docs": {
          "type": "object", "additionalProperties": false, "required": ["files_and_docs"],
          "properties": { "files_and_docs": { "$ref": "#/$defs/data_type_answer" } }
        },
        "calendar": {
          "type": "object", "additionalProperties": false, "required": ["calendar_events"],
          "properties": { "calendar_events": { "$ref": "#/$defs/data_type_answer" } }
        },
        "contacts": {
          "type": "object", "additionalProperties": false, "required": ["contacts"],
          "properties": { "contacts": { "$ref": "#/$defs/data_type_answer" } }
        },
        "app_activity": {
          "type": "object", "additionalProperties": false,
          "required": ["app_interactions", "in_app_search_history", "installed_apps", "other_user_generated_content", "other_actions"],
          "properties": {
            "app_interactions": { "$ref": "#/$defs/data_type_answer" },
            "in_app_search_history": { "$ref": "#/$defs/data_type_answer" },
            "installed_apps": { "$ref": "#/$defs/data_type_answer" },
            "other_user_generated_content": { "$ref": "#/$defs/data_type_answer" },
            "other_actions": { "$ref": "#/$defs/data_type_answer" }
          }
        },
        "web_browsing": {
          "type": "object", "additionalProperties": false, "required": ["web_browsing_history"],
          "properties": { "web_browsing_history": { "$ref": "#/$defs/data_type_answer" } }
        },
        "app_info_and_performance": {
          "type": "object", "additionalProperties": false, "required": ["crash_logs", "diagnostics", "other_app_performance_data"],
          "properties": {
            "crash_logs": { "$ref": "#/$defs/data_type_answer" },
            "diagnostics": { "$ref": "#/$defs/data_type_answer" },
            "other_app_performance_data": { "$ref": "#/$defs/data_type_answer" }
          }
        },
        "device_or_other_ids": {
          "type": "object", "additionalProperties": false, "required": ["device_or_other_ids"],
          "properties": { "device_or_other_ids": { "$ref": "#/$defs/data_type_answer" } }
        }
      }
    }
  }
}
