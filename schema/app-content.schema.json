{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SalamancaLabs/claude-google-play/schema/app-content.schema.json",
  "title": "Play Console App content answers",
  "type": "object",
  "required": [
    "package_name",
    "app_name",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "package_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "app_name": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "object",
      "required": [
        "privacy_policy",
        "app_access",
        "ads",
        "advertising_id",
        "content_rating",
        "target_audience",
        "news_app",
        "data_safety",
        "government_app",
        "financial_features",
        "health_apps"
      ],
      "additionalProperties": false,
      "properties": {
        "privacy_policy": {
          "type": "object",
          "required": [
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "$ref": "#/$defs/leaf_1",
              "description": "Public HTTPS URL of the privacy policy"
            }
          }
        },
        "app_access": {
          "type": "object",
          "required": [
            "all_functionality_available",
            "access_instructions"
          ],
          "additionalProperties": false,
          "properties": {
            "all_functionality_available": {
              "$ref": "#/$defs/leaf_2",
              "description": "true = no login or restriction blocks any feature"
            },
            "access_instructions": {
              "$ref": "#/$defs/leaf_3",
              "description": "Credentials/steps for reviewers when functionality is restricted; null when not needed"
            }
          }
        },
        "ads": {
          "type": "object",
          "required": [
            "contains_ads"
          ],
          "additionalProperties": false,
          "properties": {
            "contains_ads": {
              "$ref": "#/$defs/leaf_2"
            }
          }
        },
        "advertising_id": {
          "type": "object",
          "required": [
            "uses_advertising_id",
            "purposes"
          ],
          "additionalProperties": false,
          "properties": {
            "uses_advertising_id": {
              "$ref": "#/$defs/leaf_2"
            },
            "purposes": {
              "$ref": "#/$defs/leaf_4",
              "description": "Required when uses_advertising_id is true"
            }
          }
        },
        "content_rating": {
          "type": "object",
          "required": [
            "category",
            "questionnaire"
          ],
          "additionalProperties": false,
          "properties": {
            "category": {
              "$ref": "#/$defs/leaf_5",
              "description": "IARC questionnaire category chosen in the Console (free text: the category list is not confirmed from an official source)"
            },
            "questionnaire": {
              "type": "object",
              "description": "IARC questions vary by category; one entry per question, snake_case key",
              "additionalProperties": {
                "$ref": "#/$defs/leaf_6"
              }
            }
          }
        },
        "target_audience": {
          "type": "object",
          "required": [
            "age_groups",
            "appeals_to_children"
          ],
          "additionalProperties": false,
          "properties": {
            "age_groups": {
              "$ref": "#/$defs/leaf_7"
            },
            "appeals_to_children": {
              "$ref": "#/$defs/leaf_2"
            }
          }
        },
        "news_app": {
          "type": "object",
          "required": [
            "is_news_app"
          ],
          "additionalProperties": false,
          "properties": {
            "is_news_app": {
              "$ref": "#/$defs/leaf_2"
            }
          }
        },
        "data_safety": {
          "type": "object",
          "required": [
            "collects_or_shares_user_data",
            "data_types",
            "security"
          ],
          "additionalProperties": false,
          "properties": {
            "collects_or_shares_user_data": {
              "$ref": "#/$defs/leaf_2"
            },
            "data_types": {
              "type": "object",
              "required": [
                "location",
                "personal_info",
                "financial_info",
                "health_and_fitness",
                "messages",
                "photos_and_videos",
                "audio",
                "files_and_docs",
                "calendar",
                "contacts",
                "app_activity",
                "web_browsing",
                "app_info_and_performance",
                "device_or_other_ids"
              ],
              "additionalProperties": false,
              "properties": {
                "location": {
                  "type": "object",
                  "required": [
                    "approximate_location",
                    "precise_location"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "approximate_location": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "precise_location": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                },
                "personal_info": {
                  "type": "object",
                  "required": [
                    "name",
                    "email_address",
                    "user_ids",
                    "address",
                    "phone_number",
                    "race_and_ethnicity",
                    "political_or_religious_beliefs",
                    "sexual_orientation",
                    "other_info"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "email_address": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "user_ids": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "address": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "phone_number": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "race_and_ethnicity": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "political_or_religious_beliefs": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "sexual_orientation": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "other_info": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                },
                "financial_info": {
                  "type": "object",
                  "required": [
                    "user_payment_info",
                    "purchase_history",
                    "credit_score",
                    "other_financial_info"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "user_payment_info": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "purchase_history": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "credit_score": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "other_financial_info": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                },
                "health_and_fitness": {
                  "type": "object",
                  "required": [
                    "health_info",
                    "fitness_info"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "health_info": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "fitness_info": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                },
                "messages": {
                  "type": "object",
                  "required": [
                    "emails",
                    "sms_or_mms",
                    "other_in_app_messages"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "emails": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "sms_or_mms": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "other_in_app_messages": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                },
                "photos_and_videos": {
                  "type": "object",
                  "required": [
                    "photos",
                    "videos"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "photos": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "videos": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                },
                "audio": {
                  "type": "object",
                  "required": [
                    "voice_or_sound_recordings",
                    "music_files",
                    "other_audio_files"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "voice_or_sound_recordings": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "music_files": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "other_audio_files": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                },
                "files_and_docs": {
                  "type": "object",
                  "required": [
                    "files_and_docs"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "files_and_docs": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                },
                "calendar": {
                  "type": "object",
                  "required": [
                    "calendar_events"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "calendar_events": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                },
                "contacts": {
                  "type": "object",
                  "required": [
                    "contacts"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "contacts": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                },
                "app_activity": {
                  "type": "object",
                  "required": [
                    "app_interactions",
                    "in_app_search_history",
                    "installed_apps",
                    "other_user_generated_content",
                    "other_actions"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "app_interactions": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "in_app_search_history": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "installed_apps": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "other_user_generated_content": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "other_actions": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                },
                "web_browsing": {
                  "type": "object",
                  "required": [
                    "web_browsing_history"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "web_browsing_history": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                },
                "app_info_and_performance": {
                  "type": "object",
                  "required": [
                    "crash_logs",
                    "diagnostics",
                    "other_app_performance_data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "crash_logs": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "diagnostics": {
                      "$ref": "#/$defs/leaf_0"
                    },
                    "other_app_performance_data": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                },
                "device_or_other_ids": {
                  "type": "object",
                  "required": [
                    "device_or_other_ids"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "device_or_other_ids": {
                      "$ref": "#/$defs/leaf_0"
                    }
                  }
                }
              }
            },
            "security": {
              "type": "object",
              "required": [
                "encrypted_in_transit",
                "deletion_request_mechanism"
              ],
              "additionalProperties": false,
              "properties": {
                "encrypted_in_transit": {
                  "$ref": "#/$defs/leaf_2"
                },
                "deletion_request_mechanism": {
                  "$ref": "#/$defs/leaf_8",
                  "description": "How users can request data deletion; web_link/in_app need a URL/flow in evidence"
                }
              }
            }
          }
        },
        "government_app": {
          "type": "object",
          "required": [
            "is_government_app"
          ],
          "additionalProperties": false,
          "properties": {
            "is_government_app": {
              "$ref": "#/$defs/leaf_2"
            }
          }
        },
        "financial_features": {
          "type": "object",
          "required": [
            "features"
          ],
          "additionalProperties": false,
          "properties": {
            "features": {
              "$ref": "#/$defs/leaf_9",
              "description": "Financial features offered (e.g. loans, banking, crypto); empty list = none"
            }
          }
        },
        "health_apps": {
          "type": "object",
          "required": [
            "features"
          ],
          "additionalProperties": false,
          "properties": {
            "features": {
              "$ref": "#/$defs/leaf_9",
              "description": "Health features offered; empty list = none"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "leaf_0": {
      "type": "object",
      "required": [
        "value",
        "evidence",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "collected",
                "shared"
              ],
              "additionalProperties": false,
              "properties": {
                "collected": {
                  "type": "boolean"
                },
                "shared": {
                  "type": "boolean"
                },
                "ephemeral": {
                  "type": "boolean"
                },
                "required": {
                  "type": "boolean",
                  "description": "true = collection is required, false = users can choose"
                },
                "collection_purposes": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "app_functionality",
                      "analytics",
                      "developer_communications",
                      "advertising_or_marketing",
                      "fraud_prevention_security_compliance",
                      "personalization",
                      "account_management"
                    ]
                  },
                  "uniqueItems": true
                },
                "sharing_purposes": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "app_functionality",
                      "analytics",
                      "developer_communications",
                      "advertising_or_marketing",
                      "fraud_prevention_security_compliance",
                      "personalization",
                      "account_management"
                    ]
                  },
                  "uniqueItems": true
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "status": {
          "enum": [
            "confirmed",
            "needs_review"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "collected",
              "shared"
            ],
            "additionalProperties": false,
            "properties": {
              "collected": {
                "type": "boolean"
              },
              "shared": {
                "type": "boolean"
              },
              "ephemeral": {
                "type": "boolean"
              },
              "required": {
                "type": "boolean",
                "description": "true = collection is required, false = users can choose"
              },
              "collection_purposes": {
                "type": "array",
                "items": {
                  "enum": [
                    "app_functionality",
                    "analytics",
                    "developer_communications",
                    "advertising_or_marketing",
                    "fraud_prevention_security_compliance",
                    "personalization",
                    "account_management"
                  ]
                },
                "uniqueItems": true
              },
              "sharing_purposes": {
                "type": "array",
                "items": {
                  "enum": [
                    "app_functionality",
                    "analytics",
                    "developer_communications",
                    "advertising_or_marketing",
                    "fraud_prevention_security_compliance",
                    "personalization",
                    "account_management"
                  ]
                },
                "uniqueItems": true
              }
            }
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    "leaf_1": {
      "type": "object",
      "required": [
        "value",
        "evidence",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "status": {
          "enum": [
            "confirmed",
            "needs_review"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
